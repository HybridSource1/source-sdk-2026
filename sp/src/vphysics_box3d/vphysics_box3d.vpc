//-----------------------------------------------------------------------------
//	VPHYSICS_BOX3D.VPC
//
//	VPhysics backend built on Box3D (https://github.com/erincatto/box3d).
//	Produces vphysics_box3d.dll / vphysics_box3d.so, a drop-in replacement for
//	the engine's vphysics module. See vphysics_box3d/README.md.
//
//	Box3D is C17, so on Windows this project needs one of Mapbase's newer
//	toolsets (VS2019 or VS2022, see vpc_scripts/newer_vs_toolsets.vpc) and on
//	Linux GCC 8 or newer.
//-----------------------------------------------------------------------------

$Macro SRCDIR		".."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"
$Macro BOX3DDIR		"$SRCDIR\thirdparty\box3d"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;$BOX3DDIR\include;$BOX3DDIR\src;$SRCDIR\public\vphysics"
		$PreprocessorDefinitions			"$BASE;VPHYSICS_BOX3D"

		// Box3D's geometry and solver assume IEEE floats; keep the release -ffast-math away from them
		$GCC_ExtraCompilerFlags				"$BASE -fno-fast-math -ffp-contract=off" [$POSIX]
	}
}

$Project "vphysics_box3d"
{
	$Folder	"Source Files"
	{
		$File	"b3vp_collide.cpp"
		$File	"b3vp_constraints.cpp"
		$File	"b3vp_controllers.cpp"
		$File	"b3vp_environment.cpp"
		$File	"b3vp_interface.cpp"
		$File	"b3vp_object.cpp"
		$File	"b3vp_parse.cpp"
		$File	"b3vp_surfaceprops.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"b3vp_base.h"
		$File	"b3vp_collide.h"
		$File	"b3vp_constraints.h"
		$File	"b3vp_controllers.h"
		$File	"b3vp_environment.h"
		$File	"b3vp_object.h"
		$File	"b3vp_parse.h"
		$File	"b3vp_surfaceprops.h"
		$File	"$SRCDIR\public\vphysics_interface.h"
		$File	"$SRCDIR\public\vcollide_parse.h"
	}

	$Folder	"Box3D"
	{
		$Folder	"Source Files"
		{
			$File	"$BOX3DDIR\src\aabb.c"
			{
				$Configuration
				{
					$Compiler
					{
						$CompileAs						"Compile as C Code (/TC)"
						$FloatingPointModel				"Precise (/fp:precise)"
						$AdditionalOptions				"$BASE /std:c17 /wd4244 /wd4305 /wd4267 /wd4100" [$WINDOWS]
						$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
					}
				}
			}
